# Copy this file to .env for local, non-secret configuration only.
# Store secret values in ignored files under .secrets/.

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=webcam_ingestion
DATABASE_USER=webcam_ingestion
DATABASE_PASSWORD_FILE=.secrets/database_password
DATABASE_POOL_SIZE=5

DISCOVERY_METRICS_ENABLED=true
DISCOVERY_METRICS_GATEWAY_URL=http://localhost:9091
DISCOVERY_METRICS_PUSH_TIMEOUT_S=5
BATCH_METRICS_ENABLED=true
BATCH_METRICS_GATEWAY_URL=http://localhost:9091
BATCH_METRICS_PUSH_TIMEOUT_S=5

# JSON file containing overlapping query discs. Keep at most 10 country codes per disc.
WINDY_API_KEY_FILE=.secrets/windy_api_key
WINDY_DISCOVERY_AREAS_FILE=discovery/windy/discovery_areas.json
WINDY_MEMBER_COUNTRIES=AT,BE,HR,CY,CZ,DK,EE,FI,FR,DE,GR,HU,IS,IE,IT,LV,LU,ME,NL,LT,MT,NO,PL,PT,RO,RS,SK,SI,ES,SE,CH,MK,GB
WINDY_REQUEST_DELAY_S=0.1
WINDY_DISCOVERY_CACHE_FILE=.discovery-cache/windy_pages.json
WINDY_SITE_DISTANCE_THRESHOLD_M=10
PROVIDER_REQUEST_TIMEOUT_S=15
FINTRAFFIC_USER_HEADER=webcam-iot-ingest
FINTRAFFIC_STATIONS_URL=https://tie.digitraffic.fi/api/weathercam/v1/stations
FINTRAFFIC_DISCOVERY_RETRY_COUNT=2
FINTRAFFIC_DISCOVERY_RETRY_BACKOFF_S=1
FINTRAFFIC_DISCOVERY_REQUEST_DELAY_S=0.1
FINTRAFFIC_SELECTED_COLLECTION_STATUS=GATHERING
FINTRAFFIC_REQUIRE_IN_COLLECTION=true
FINTRAFFIC_STATIONS_DATA_URL=https://tie.digitraffic.fi/api/weathercam/v1/stations/data
FINTRAFFIC_IMAGE_BASE_URL=https://weathercam.digitraffic.fi
FINTRAFFIC_FRESHNESS_QUERY_RETRY_COUNT=0
FINTRAFFIC_DOWNLOAD_RETRY_COUNT=0
FINTRAFFIC_INGESTION_REQUEST_DELAY_S=0.1
FINTRAFFIC_INGESTION_DEFAULT_LIMIT=10

SKAPING_API_KEY_FILE=.secrets/skaping_api_key
SKAPING_SUMMARY_URL=https://api.skaping.com/camera/summaryApp
SKAPING_DISCOVERY_RETRY_COUNT=2
SKAPING_DISCOVERY_RETRY_BACKOFF_S=1
SKAPING_DISCOVERY_REQUEST_DELAY_S=0
SKAPING_DISCOVERY_MIN_CAMERAS=20
SKAPING_MEMBER_COUNTRIES=AT,BE,HR,CY,CZ,DK,EE,FI,FR,DE,GR,HU,IS,IE,IT,LV,LU,ME,NL,LT,MT,NO,PL,PT,RO,RS,SK,SI,ES,SE,CH,MK,GB
SKAPING_INGESTION_REQUEST_DELAY_S=0.1
SKAPING_FRESHNESS_QUERY_RETRY_COUNT=0
SKAPING_DOWNLOAD_RETRY_COUNT=0
SKAPING_INGESTION_DEFAULT_LIMIT=10

ALTITUDE_PROVIDER_ENABLED=true
ALTITUDE_PROVIDER_URL=https://api.open-meteo.com/v1/elevation
ALTITUDE_REQUEST_TIMEOUT_S=15
ALTITUDE_BATCH_SIZE=100
ALTITUDE_REQUEST_DELAY_S=0.1
ALTITUDE_MAX_ATTEMPTS=3
ALTITUDE_MAX_SITES_PER_RUN=5000

MINIMUM_INGESTION_INTERVAL_S=300
POLLING_INTERVAL_FACTOR=0.7
WINDY_MINIMUM_INGESTION_INTERVAL_S=300
WINDY_MINIMUM_POLLING_INTERVAL_S=540
WINDY_POLLING_INTERVAL_FACTOR=0.7
WINDY_INITIAL_EMA_DOWNLOAD_PERIOD_S=120
WINDY_INGESTION_REQUEST_DELAY_S=0.1
IMAGE_DOWNLOAD_TIMEOUT_S=15
SOURCE_IMAGE_MAX_BYTES=10000000
WINDY_FRESHNESS_QUERY_RETRY_COUNT=0
WINDY_DOWNLOAD_RETRY_COUNT=0
RETRY_BACKOFF_S=1
EMA_ALPHA=0.2
WINDY_INGESTION_DEFAULT_LIMIT=10
FINTRAFFIC_MINIMUM_POLLING_INTERVAL_S=480
SKAPING_MINIMUM_POLLING_INTERVAL_S=240

TRANSFORMATION_VERSION=T0V0
MAX_DERIVED_HEIGHT_PX=288
JPEG_QUALITY_INITIAL=90
TARGET_IMAGE_SIZE_BYTES=50000
TARGET_PANORAMIC_IMAGE_SIZE_BYTES=200000
PANORAMIC_ASPECT_RATIO_THRESHOLD=2.0

S3_ENDPOINT_URL=https://s3.example.invalid
S3_BUCKET=webcam
S3_PREFIX=
S3_PUBLIC_URL_BASE=https://s3.example.invalid/webcam
S3_REGION=
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_FILE=.secrets/s3_access_key
S3_SECRET_KEY_FILE=.secrets/s3_secret_key
S3_UPLOAD_RETRY_COUNT=1
DATABASE_BACKUP_S3_PREFIX=backups/postgresql
PG_DUMP_BINARY=pg_dump
PG_DUMP_MODE=docker-compose

MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_TLS=False
MQTT_PROTOCOL_VERSION=5
MQTT_TOPIC_PREFIX=webcam
MQTT_QOS=1
MQTT_PUBLICATION_RETRY_COUNT=1

INGESTION_WORKER_THREADS=4
INGESTION_MAX_JOBS_PER_EPOCH=100
INGESTION_IDLE_DELAY_S=5
INGESTION_FAILURE_BACKOFF_S=10
INGESTION_SHUTDOWN_GRACE_S=30
INGESTION_HEALTH_HOST=0.0.0.0
INGESTION_HEALTH_PORT=8002
INGESTION_DATABASE_POOL_SIZE=16
INGESTION_MIN_EPOCH_PERIOD_S=15
INITIAL_STAGGER_WINDOW_S=600
WINDY_CPU_LIMIT=4.0
WINDY_MEMORY_LIMIT=2g
FINTRAFFIC_CPU_LIMIT=2.0
FINTRAFFIC_MEMORY_LIMIT=1g
SKAPING_CPU_LIMIT=1.0
SKAPING_MEMORY_LIMIT=512m

# Legacy FastAPI upload path (retained while the autonomous workflow replaces it).
BUCKET_NAME=webcam
BUCKET_ENDPOINT_URL=https://s3.example.invalid
BUCKET_OBJECT_URL=https://s3.example.invalid/webcam
