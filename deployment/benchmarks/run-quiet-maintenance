#!/usr/bin/env bash
set -uo pipefail

first_offset_s="${1:-1200}"
second_offset_s="${2:-3600}"
cleanup_age_h="${3:-24}"
notify_summary="${4:-false}"
started_epoch="$(date +%s)"
status=0

wait_until_offset() {
    local offset_s="$1"
    local remaining_s=$((started_epoch + offset_s - $(date +%s)))
    if ((remaining_s > 0)); then
        sleep "$remaining_s"
    fi
}

run_cycle() {
    local cycle="$1"
    local result_prefix="/tmp/discovery-result-${cycle}"
    local windy_result="${result_prefix}-windy.jsonl"
    local fintraffic_result="${result_prefix}-fintraffic.jsonl"
    local skaping_result="${result_prefix}-skaping.jsonl"
    echo "{\"quiet_maintenance\":{\"cycle\":${cycle},\"event\":\"started\",\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}"
    python -m storage.s3_spool_cleanup \
        --older-than-hours "$cleanup_age_h" \
        --transformation-prefix T0V0 || status=1
    python -m discovery.windy.windy_discovery_workflow \
        | tee "$windy_result" || status=1
    python -m discovery.fintraffic.fintraffic_discovery_workflow \
        | tee "$fintraffic_result" || status=1
    python -m discovery.skaping.skaping_discovery_workflow \
        | tee "$skaping_result" || status=1
    python -m database.database_backup --pg-dump-mode direct || status=1
    if [[ "$notify_summary" == "true" && "$status" == "0" ]]; then
        python -m observability.discovery_summary_alert notify \
            "$windy_result" "$fintraffic_result" "$skaping_result" || status=1
    fi
    echo "{\"quiet_maintenance\":{\"cycle\":${cycle},\"event\":\"completed\",\"status\":${status},\"timestamp\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}}"
    rm -f "$windy_result" "$fintraffic_result" "$skaping_result"
}

wait_until_offset "$first_offset_s"
run_cycle 1
if ((second_offset_s > 0)); then
    wait_until_offset "$second_offset_s"
    run_cycle 2
fi
exit "$status"
