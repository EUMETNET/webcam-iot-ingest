[Unit]
Description=Containerized webcam discovery for %i
Requires=webcam-stack.service
After=webcam-stack.service network-online.target

[Service]
Type=oneshot
User=codexuser
Group=codexuser
WorkingDirectory=/opt/webcam-ingestion
ExecStart=/opt/webcam-ingestion/deployment/systemd/pilot/run-discovery %i
TimeoutStartSec=3600
