[Unit]
Description=Checkpoint-12 cleanup of image objects older than one hour
Requires=webcam-checkpoint12-infrastructure.service
After=webcam-checkpoint12-infrastructure.service network-online.target

[Service]
Type=oneshot
User=codexuser
Group=codexuser
Environment=PATH=/home/codexuser/.local/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=/home/codexuser/src/webcam-iot-ingest
ExecStart=/home/codexuser/.local/bin/just cleanup-spool 1
