[Unit]
Description=Webcam checkpoint-12 local infrastructure
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/codexuser/src/webcam-iot-ingest
ExecStart=/usr/bin/docker compose --env-file .env --profile monitoring up -d
ExecStop=/usr/bin/docker compose --env-file .env --profile monitoring stop
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
