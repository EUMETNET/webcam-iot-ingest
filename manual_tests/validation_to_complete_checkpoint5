    git status --short
    git diff -- .env.example config/deployment_config.py database/registry_queries.py ingestion tests history/checkpoint4_work_record.txt history/checkpoint5_work_record.txt manual_tests/validation_to_complete_checkpoint4 manual_tests/validation_to_complete_checkpoint5

