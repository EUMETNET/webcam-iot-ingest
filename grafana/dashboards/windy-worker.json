{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "hidden" }, "tooltip": { "mode": "single" } },
      "targets": [{
        "expr": "sum(webcam_ingestion_epoch_total{result=\"success\"})",
        "legendFormat": "completed epochs"
      }],
      "description": "Cumulative successful epochs since the worker process started. Each upward step is an epoch completion; flat sections show time spent inside longer epochs.",
      "title": "Completed epochs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "max(webcam_source_stream_due_count)", "legendFormat": "selected" }],
      "title": "Streams selected",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(irate(webcam_ingestion_job_total[1m]))", "legendFormat": "jobs/s" }],
      "description": "Near-instantaneous completion rate calculated with Prometheus irate over the trailing 1 minute.",
      "title": "Completion rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [{ "expr": "sum(webcam_publication_outbox_pending_count)", "legendFormat": "pending" }],
      "title": "Publication outbox",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "expr": "sum(irate(webcam_ingestion_job_total[1m])) by (result)",
        "legendFormat": "{{result}}"
      }],
      "description": "Near-instantaneous outcome rates calculated with Prometheus irate over the trailing 1 minute. Unlike a 5-minute rate, these series return to zero soon after activity stops.",
      "title": "Job outcomes",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "expr": "sum(rate(webcam_ingestion_stage_duration_seconds_sum{outcome=\"success\"}[5m])) by (stage) / sum(rate(webcam_ingestion_stage_duration_seconds_count{outcome=\"success\"}[5m])) by (stage)",
        "legendFormat": "mean {{stage}}"
      }],
      "description": "Rolling means use samples observed during the trailing 5 minutes. provider_refresh is total metadata time; provider_rate_gate_wait and provider_http split its controlled queueing and HTTP components.",
      "title": "Mean stage duration (refresh = gate + HTTP)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(webcam_ingestion_stage_duration_seconds_bucket{outcome=\"success\"}[5m])) by (le, stage))",
          "legendFormat": "p50 {{stage}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(webcam_ingestion_stage_duration_seconds_bucket{outcome=\"success\"}[5m])) by (le, stage))",
          "legendFormat": "p95 {{stage}}"
        }
      ],
      "description": "Approximate p50 and p95 values from Prometheus histogram samples observed during the trailing 5 minutes.",
      "title": "P50 and P95 stage duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(irate(webcam_ingestion_job_total{result=\"throttled\"}[1m]))", "legendFormat": "throttled/s" },
        { "expr": "sum(irate(webcam_ingestion_stage_failure_total[1m])) by (stage, reason)", "legendFormat": "{{stage}} · {{reason}}/s" }
      ],
      "description": "Near-instantaneous throttling and controlled-failure rates calculated with Prometheus irate over the trailing 1 minute.",
      "title": "Controlled failures and throttling",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 9,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(webcam_ingestion_image_latency_seconds_bucket[5m])) by (le, measure))",
          "legendFormat": "p50 {{measure}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(webcam_ingestion_image_latency_seconds_bucket[5m])) by (le, measure))",
          "legendFormat": "p95 {{measure}}"
        }
      ],
      "description": "Approximate p50 and p95 image-latency values from Prometheus histogram samples observed during the trailing 5 minutes.",
      "title": "Provider → download → completed MQTT latency",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 10,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{
        "expr": "sum(rate(webcam_ingestion_source_job_duration_seconds_sum[5m])) by (outcome) / sum(rate(webcam_ingestion_source_job_duration_seconds_count[5m])) by (outcome)",
        "legendFormat": "mean {{outcome}}"
      }],
      "description": "Rolling mean source-job duration by outcome, using samples observed during the trailing 5 minutes.",
      "title": "Mean source-job duration",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 28 },
      "id": 11,
      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "expr": "sum(rate(webcam_ingestion_job_total[5m]))",
          "legendFormat": "completed jobs/s"
        },
        {
          "expr": "sum(rate(webcam_ingestion_job_total{result=\"published\"}[5m]))",
          "legendFormat": "published images/s"
        }
      ],
      "description": "Five-minute smoothed throughput. Completed jobs include unchanged and failed checks as well as publications; published images completed both S3 upload and MQTT publication.",
      "title": "5-minute throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["windy", "worker", "benchmark"],
  "templating": {
    "list": [{
      "current": {},
      "hide": 0,
      "includeAll": false,
      "label": "Prometheus",
      "name": "DS_PROMETHEUS",
      "options": [],
      "query": "prometheus",
      "refresh": 1,
      "type": "datasource"
    }]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timezone": "browser",
  "title": "Windy ingestion worker",
  "uid": "windy-ingestion-worker",
  "version": 1
}
