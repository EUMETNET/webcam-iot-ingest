      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (webcam_ingestion_epoch_duration_seconds_bucket{source_network=\"win\"}))",
          "instant": true,
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.90, sum by (le) (webcam_ingestion_epoch_duration_seconds_bucket{source_network=\"win\"}))",
          "instant": true,
          "legendFormat": "p90"
        }
      ],
      "description": "Wall-clock duration of completed epochs, from due-stream selection through batched freshness, parallel source jobs, and the final bulk database commit. Values are not divided by stream count; the active epoch is excluded until it completes.",
      "title": "Completed-epoch wall time (P50/P90)",
      "type": "stat"
    },
    {
      "datasource": {
