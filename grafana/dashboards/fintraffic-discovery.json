{
  "annotations": {"list": []},
  "description": "Persistent metrics for Fintraffic discovery batch jobs.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Counters accumulated across Fintraffic discovery runs.",
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [
        {"expr": "sum(webcam_discovery_run_total{source_network=\"fin\",result=\"success\"})", "legendFormat": "successful"},
        {"expr": "sum(webcam_discovery_run_total{source_network=\"fin\",result=\"failure\"}) or vector(0)", "legendFormat": "failed"}
      ],
      "title": "Discovery runs",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Wall-clock duration of the latest successful complete run.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "webcam_discovery_last_duration_seconds{source_network=\"fin\"}", "legendFormat": "latest"}],
      "title": "Latest run duration",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Timestamp pushed by the latest successful Fintraffic discovery.",
      "fieldConfig": {"defaults": {"unit": "dateTimeFromNow"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "webcam_discovery_last_success_unixtime{source_network=\"fin\"} * 1000", "legendFormat": "last success"}],
      "title": "Last successful run",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Current Fintraffic registry state, replaced after each successful run.",
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "targets": [{"expr": "webcam_source_stream_status_count{source_network=\"fin\"}", "legendFormat": "{{status}}"}],
      "title": "Source-stream status",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Cumulative stream counts. Added, refreshed, and disabled are zero for dry runs.",
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "webcam_discovery_sources_seen_total{source_network=\"fin\"}", "legendFormat": "seen"},
        {"expr": "webcam_discovery_sources_added_total{source_network=\"fin\"}", "legendFormat": "added"},
        {"expr": "webcam_discovery_sources_updated_total{source_network=\"fin\"}", "legendFormat": "refreshed"},
        {"expr": "webcam_discovery_sources_disabled_total{source_network=\"fin\"}", "legendFormat": "disabled"}
      ],
      "title": "Cumulative discovery stream results",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Quantiles across retained Fintraffic discovery runs.",
      "fieldConfig": {"defaults": {"decimals": 2, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (webcam_discovery_duration_seconds_bucket{source_network=\"fin\"}))", "legendFormat": "p50"},
        {"expr": "histogram_quantile(0.95, sum by (le) (webcam_discovery_duration_seconds_bucket{source_network=\"fin\"}))", "legendFormat": "p95"}
      ],
      "title": "Discovery duration distribution",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "One list request plus one detail request per eligible station; retries are additional attempts.",
      "fieldConfig": {"defaults": {"decimals": 0, "unit": "short"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 11},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "webcam_provider_request_total{source_network=\"fin\"}", "legendFormat": "{{endpoint_type}} · {{result}}"},
        {"expr": "webcam_provider_throttling_total{source_network=\"fin\"}", "legendFormat": "throttled"}
      ],
      "title": "Provider request outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "description": "Per-attempt latency separated between the station list and detailed station requests.",
      "fieldConfig": {"defaults": {"decimals": 3, "unit": "s"}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 11},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le, endpoint_type) (webcam_provider_request_duration_seconds_bucket{source_network=\"fin\"}))", "legendFormat": "{{endpoint_type}} p50"},
        {"expr": "histogram_quantile(0.95, sum by (le, endpoint_type) (webcam_provider_request_duration_seconds_bucket{source_network=\"fin\"}))", "legendFormat": "{{endpoint_type}} p95"}
      ],
      "title": "Provider request duration",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["webcam", "discovery", "fintraffic"],
  "templating": {"list": [{"current": {"text": "Prometheus", "value": "Prometheus"}, "hide": 2, "name": "DS_PROMETHEUS", "query": "prometheus", "type": "datasource"}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Fintraffic discovery",
  "uid": "fintraffic-discovery",
  "version": 1
}
